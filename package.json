{
  "name": "deskmate",
  "version": "0.1.0",
  "description": "The colleague at the next desk - a local-first office app with Tams, an assistant that runs on your own machine.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "tsc -p server --noEmit && tsc -p web --noEmit && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "seed": "tsx server/src/cli/seed.ts",
    "index": "tsx server/src/cli/reindex.ts",
    "samples": "tsx scripts/build-sample-office.ts",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "tsx --test server/src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unpdf": "^1.8.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.9.0",
    "pdf-lib": "^1.17.1"
  }
}
