# Deskmate runs with no configuration at all. Everything here is optional.
# Copy this file to .env to change a default.

# Port for the app (API and web on the same port).
PORT=4747

# Local models, served by Ollama on this machine.
OLLAMA_HOST=http://127.0.0.1:11434
DESKMATE_CHAT_MODEL=qwen3:4b
DESKMATE_EMBED_MODEL=nomic-embed-text

# Optional cloud mode for Tams. Leave empty to stay fully local.
# When set and the network is up, the chat header offers "Cloud (Claude)".
ANTHROPIC_API_KEY=

# Optional Google sign-in and Drive mirror. Leave both empty to run without Google.
# Create an OAuth client of type "Web application" in your own Google Cloud project,
# enable the Google Drive API, and register this redirect URI:
#   http://localhost:4747/auth/google/callback
# Never commit real values. They can also live in ~/.deskmate-google.env,
# so they never sit in the repo folder at all. The README has the steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if the app does not run at http://localhost:4747.
# GOOGLE_REDIRECT_URI=http://localhost:4747/auth/google/callback
